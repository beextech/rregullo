/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; media-src 'self'; style-src 'self'; script-src 'self'; font-src 'self'; manifest-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests

# The mjeshtër panel also loads Cloudflare Turnstile (the bot check before an SMS is sent), and previews photos
# from blob: URLs while they upload.
/mjeshtri/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; img-src 'self' data: blob:; style-src 'self'; script-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; font-src 'self'; manifest-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  Cache-Control: no-cache

# The team admin: like the mjeshtër panel without Turnstile, and never indexed.
/admin/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; img-src 'self' data: blob:; style-src 'self'; script-src 'self'; font-src 'self'; manifest-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  Cache-Control: no-cache
  X-Robots-Tag: noindex

# "Thirrjet e mia" lives only in the visitor's browser; nothing to index.
/thirrjet
  X-Robots-Tag: noindex
  Cache-Control: no-cache

# The directory's stylesheet and script are always linked with ?v=<hash>.
/kerko/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/site.css
  Cache-Control: public, max-age=31536000, immutable

/site.js
  Cache-Control: public, max-age=31536000, immutable

/media/*
  Cache-Control: public, max-age=604800

/icons/*
  Cache-Control: public, max-age=604800

# Visitors who land on http:// (no redirect at the zone) get this module upgraded to https, which makes it a
# cross-origin load; allowing it keeps the craftsman form working there. Public static file, no credentials.
/mjeshter.js
  Access-Control-Allow-Origin: *
